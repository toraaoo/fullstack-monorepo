APP_NAME="API"
APP_VERSION=1.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# development | dev | staging | production | test
NODE_ENV=development

# Mounts the Scalar API reference at /docs. Leave off in production.
API_DOCS_ENABLED=true

# Adds the raw message and stacktrace to 5xx error responses.
# Follows NODE_ENV when unset. Set it to override either way.
# API_DEBUG_ERRORS=true

# fatal | error | warn | info | debug | trace | silent
# debug logs every SQL statement drizzle runs.
LOG_LEVEL=debug

# Required. The app exits at boot without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace

DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Set false behind a transaction-mode pooler (PgBouncer, Supabase 6543).
DATABASE_PREPARE=true

# LIMIT requests per TTL seconds.
THROTTLER_TTL=60
THROTTLER_LIMIT=60

# Comma-separated. "*" is refused at boot outside development.
ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_HEADERS="Content-Type,Authorization"
MAX_AGE=3600
CREDENTIALS=true
