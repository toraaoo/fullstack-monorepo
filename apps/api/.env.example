APP_NAME="API"
APP_VERSION=1.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
NODE_ENV=development

# Mounts the Scalar API reference at /docs. Leave unset or false in production.
API_DOCS_ENABLED=true

# Puts the raw error message and stacktrace in error responses.
# Unset follows NODE_ENV: on for development/dev/test, off everywhere else.
# Set it explicitly to override in either direction.
# API_DEBUG_ERRORS=true

# fatal | error | warn | info | debug | trace | silent
# Set debug to see every SQL statement drizzle runs.
LOG_LEVEL=debug

# Required -- the app exits at boot without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace

DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Set false behind a transaction-mode pooler (PgBouncer, Supabase port 6543).
DATABASE_PREPARE=true

THROTTLER_TTL=60
THROTTLER_LIMIT=60

# Comma-separated. "*" is refused at boot unless NODE_ENV is development/dev/test.
ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_HEADERS="Content-Type,Authorization"
MAX_AGE=3600
CREDENTIALS=true
