APP_NAME="API"
APP_VERSION=1.0.0
APP_PORT=8001
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC
NODE_ENV=development

# Mounts the Scalar API reference at /docs. Leave unset or false in production.
API_DOCS_ENABLED=true

# No ORM is wired up yet; src/core/database is an empty seam. Left blank so the
# app boots without a database.
DATABASE_URL=

THROTTLER_TTL=60
THROTTLER_LIMIT=60

ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
ALLOWED_HEADERS="Content-Type,Authorization"
MAX_AGE=3600
CREDENTIALS=true
