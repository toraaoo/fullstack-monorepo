{
  "extends": "@workspace/typescript-config/nestjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "db/**/*",
    "tests/**/*",
    "drizzle.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
