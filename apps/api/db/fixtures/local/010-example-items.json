        "batch": "batch-{{int:1000..9999}}",
        "grade": "{{pick:alpha|beta|gamma}}",
        "reviewedAt": "{{date:2024-01-15}}",
        "tags": ["demo", "{{pick:calibrated|uncalibrated}}"]
      }
    },
    {
      "reference": "ITEM-0002",
      "categoryId": "{{ref:example_categories.materials.id}}",
