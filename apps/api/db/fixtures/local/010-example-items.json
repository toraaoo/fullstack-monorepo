{
  "table": "example_items",
  "description": "Scaffolding. Local environment: demo data, opt in with --env=local.",
  "conflictTarget": ["reference"],
  "rows": [
    {
      "reference": "ITEM-0001",
      "categoryId": "{{ref:example_categories.tools.id}}",
