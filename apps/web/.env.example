# Inlined into the client bundle at build time -- must be the API origin the
# browser can reach. Changing it requires a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Server Components use this instead, so server-side traffic can stay
# on an internal network. Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://api:8000
