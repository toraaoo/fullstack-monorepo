{
  "name": "@workspace/schemas",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      },
      "require": {
        "types": "./dist/i18n/index.d.cts",
        "default": "./dist/i18n/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http/index.d.ts",
        "default": "./dist/http/index.js"
      },
      "require": {
        "types": "./dist/http/index.d.cts",
        "default": "./dist/http/index.cjs"
      }
    },
    "./health": {
      "import": {
        "types": "./dist/health/index.d.ts",
        "default": "./dist/health/index.js"
      },
      "require": {
        "types": "./dist/health/index.d.cts",
        "default": "./dist/health/index.cjs"
      }
    },
    "./access": {
      "import": {
        "types": "./dist/access/index.d.ts",
        "default": "./dist/access/index.js"
      },
      "require": {
        "types": "./dist/access/index.d.cts",
        "default": "./dist/access/index.cjs"
      }
    }
  }
}
