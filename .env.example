# Compose only. Copy to .env before `docker compose up`.
# Per-app development config lives in apps/api/.env and apps/web/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workspace

# Postgres is published on the loopback interface only, so drizzle-kit and the seeder
# can reach it from the host. Set POSTGRES_BIND=0.0.0.0 to expose it further, or drop
# the ports entry in compose.yaml to keep it on the compose network alone.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Published ports. The browser calls the API directly, so API_PORT must be reachable.
WEB_PORT=3000
API_PORT=8000

# Baked into the web bundle at build time. Changing it needs a rebuild, not a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

APP_NAME="API"
LOG_LEVEL=info
API_DOCS_ENABLED=false

# The API is public, so CORS decides who may call it. List every web origin.
ALLOWED_ORIGINS=http://localhost:3000

# The API's own public address.
# API_PUBLIC_URL=https://api.example.com

# Set to pull prebuilt images instead of building locally.
# API_IMAGE=ghcr.io/you/workspace-api:1.0.0
# WEB_IMAGE=ghcr.io/you/workspace-web:1.0.0
