# Compose-only. Copy to .env at the repo root: cp .env.example .env
# Per-app development config still lives in apps/api/.env and apps/web/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workspace

# Published ports. The browser calls the API directly, so it must be reachable.
WEB_PORT=3000
API_PORT=8000

# Baked into the web bundle at build time -- the API origin the browser calls.
# Changing it needs `docker compose build web`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

APP_NAME="API"
LOG_LEVEL=info
API_DOCS_ENABLED=false

# The API is public, so CORS decides who may call it. List every web origin.
ALLOWED_ORIGINS=http://localhost:3000
# API_PUBLIC_URL=https://api.example.com

# Set to pull prebuilt images from a registry instead of building locally.
# API_IMAGE=ghcr.io/you/workspace-api:1.0.0
# WEB_IMAGE=ghcr.io/you/workspace-web:1.0.0
